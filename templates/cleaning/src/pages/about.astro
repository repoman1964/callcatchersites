---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import PageHero from '../components/sections/PageHero.astro';
import Story from '../components/sections/Story.astro';
import Reviews from '../components/sections/Reviews.astro';
import FindUs from '../components/sections/FindUs.astro';
import { site, biz, telHref, areas, allServices, trustPoints, cta } from '../lib/site';
import { breadcrumbs } from '../lib/schema';

const about = site.about;
const heading = `${biz.trade} serving ${biz.region}`;
---

<BaseLayout title={about.meta.title} description={about.meta.description} schema={[breadcrumbs([{ name: 'About', path: '/about' }])]} active="about" heading={heading}>
  <PageHero label="Our Company" title={`<span class="capitalize">${biz.trade}</span> serving ${biz.region}`} sub={about.hero_sub} crumb="About Us" ariaLabel="About page header">
    <!-- Bold typographic stat row -->
    <div class="grid grid-cols-2 gap-x-8 gap-y-5 mt-10 pt-10 border-t border-white/10 hero-fade-up" style="animation-delay: 390ms" aria-label="Company highlights">
      <div>
        <p class="font-heading text-[3rem] font-bold text-text-on-dark leading-none m-0 max-w-none">{areas.length}</p>
        <p class="text-[0.6875rem] font-semibold tracking-[0.1em] uppercase text-text-on-dark-muted mt-2 m-0 max-w-none">Service Areas</p>
      </div>
      <div>
        <p class="font-heading text-[3rem] font-bold text-text-on-dark leading-none m-0 max-w-none">{allServices.length}+</p>
        <p class="text-[0.6875rem] font-semibold tracking-[0.1em] uppercase text-text-on-dark-muted mt-2 m-0 max-w-none">Services Offered</p>
      </div>
    </div>
  </PageHero>

  <Story paragraphs={about.story_paragraphs} />

  <section class="section-pad" aria-labelledby="values-heading">
    <div class="container-site">
      <div class="max-w-[520px] mb-10 reveal">
        <span class="section-label">How We Work</span>
        <h2 id="values-heading" class="text-[clamp(1.75rem,_4vw,_2.25rem)] font-bold">{about.values_heading}</h2>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5 reveal-stagger">
        {about.values.map((v) => (
          <div class="card p-8 flex flex-col gap-[0.875rem]">
            <div class="w-10 h-10 bg-accent-light rounded-lg flex items-center justify-center text-accent" aria-hidden="true"><Icon n="97a5e2" /></div>
            <h3 class="font-heading text-[1.0625rem] font-bold text-text leading-[1.25]">{v.title}</h3>
            <p class="text-[0.9rem] text-text-secondary leading-[1.65]">{v.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <Reviews />
  <FindUs />

  <section class="bg-dark-bg py-[clamp(3.5rem,_7vw,_5.5rem)]" aria-labelledby="about-cta-heading">
    <div class="container-site max-w-[680px] mx-auto text-center flex flex-col items-center gap-6">
      <span class="inline-flex items-center gap-2 rounded-full border border-border-on-dark px-4 py-[0.375rem] text-[0.6875rem] font-semibold uppercase tracking-[0.1em] text-accent-on-dark">{about.cta_badge}</span>
      <h2 id="about-cta-heading" class="font-heading text-[clamp(1.875rem,_4.5vw,_2.75rem)] font-bold text-text-on-dark leading-[1.1] m-0 max-w-none">{about.cta_heading}</h2>
      <p class="text-[1.0625rem] text-text-on-dark-muted leading-[1.65] max-w-[52ch] m-0">{about.cta_body}</p>
      <div class="flex flex-wrap gap-3 justify-center items-center">
        <button type="button" data-open-quote-modal class="btn-primary py-3.5 px-8">{cta.quote}</button>
        <a href={telHref} class="btn-ghost-light py-3.5 px-7">Call {biz.phone}</a>
      </div>
      <div class="flex flex-wrap items-center justify-center gap-x-5 gap-y-2 pt-4 border-t border-border-on-dark mt-2 w-full">
        {trustPoints.slice(0, 3).map((t) => <span class="flex items-center gap-1.5 text-xs text-text-on-dark-muted"><Icon n="98db70" /> {t}</span>)}
      </div>
    </div>
  </section>
</BaseLayout>
