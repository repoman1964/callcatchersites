---
import Icon from '../Icon.astro';
import { biz, lead, telHref, hours } from '../../lib/site';

interface Props {
  bg?: 'bg-bg-warm' | 'bg-surface';
}
const { bg = 'bg-surface' } = Astro.props;
// Kai's build uses the Maps Embed API with their own key. Without a key we fall back to the keyless embed.
const mapSrc = lead.maps_embed_key
  ? `https://www.google.com/maps/embed/v1/place?key=${lead.maps_embed_key}&q=place_id:${biz.google_place_id}&zoom=15`
  : `https://maps.google.com/maps?q=${encodeURIComponent(`${biz.name}, ${biz.hq}`)}&z=13&output=embed`;
---

<section class={`section-pad ${bg}`} id="find-us" aria-labelledby="map-heading">
  <div class="container-site">
    <div class="max-w-[640px] mb-12 reveal">
      <span class="section-label">Find Us</span>
      <h2 id="map-heading" class="text-[clamp(1.875rem,4vw,2.5rem)] font-bold mb-4">Proudly Based in {biz.hq}</h2>
      <p class="text-[1.0625rem] text-text-secondary leading-[1.65]">Stop by, call, or book online — we're always nearby when you need us.</p>
    </div>
    <div class="grid md:grid-cols-[1fr_1.4fr] gap-8 lg:gap-12 items-stretch reveal">
      <!-- ── Info panel ───────────────────────────────────────── -->
      <div class="bg-surface-raised border border-border rounded-xl p-8 flex flex-col gap-8">
        <!-- Phone -->
        <div class="flex gap-4">
          <div class="shrink-0 w-10 h-10 rounded-lg bg-accent/10 flex items-center justify-center"><Icon n="135732" /></div>
          <div>
            <p class="text-[0.75rem] font-semibold tracking-[0.08em] uppercase text-text-muted mb-1">Phone</p>
            <a href={telHref} class="font-semibold text-text hover:text-accent transition-colors">{biz.phone}</a>
          </div>
        </div>
        <!-- Hours -->
        <div class="flex gap-4">
          <div class="shrink-0 w-10 h-10 rounded-lg bg-accent/10 flex items-center justify-center"><Icon n="e23222" /></div>
          <div class="flex-1">
            <p class="text-[0.75rem] font-semibold tracking-[0.08em] uppercase text-text-muted mb-2">Hours</p>
            <ul class="space-y-1" role="list">
              {hours.map((h) => (
                <li class="flex justify-between gap-4 text-sm">
                  <span class="text-text-secondary">{h.days}</span>
                  <span class="font-medium text-text">{h.time}</span>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </div>
      <!-- ── Map ──────────────────────────────────────────────── -->
      <div class="rounded-xl overflow-hidden border border-border shadow-md min-h-[340px] md:min-h-0">
        <iframe src={mapSrc} title={`Map showing ${biz.name} location in ${biz.hq}`} style="width:100%;height:100%;min-height:340px;border:0;" allowfullscreen loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
      </div>
    </div>
  </div>
</section>
