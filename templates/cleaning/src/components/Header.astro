---
import Icon from './Icon.astro';
import { biz, telHref, categories, areas, categoryHref, serviceHref, areaHref, cta } from '../lib/site';

interface Props {
  active?: 'about' | 'contact';
}
const { active } = Astro.props;
const topLink = 'flex items-center gap-1 px-4 py-2 text-base font-[900] rounded-md transition-colors duration-150 no-underline hover:text-accent hover:bg-accent-light';
const activeCls = (key: string) => (active === key ? 'text-accent bg-accent-light' : 'text-text-secondary');
---

<header data-site-header data-transparent-on-hero="true" class="site-header top-0 z-[100] transition-[background-color,border-color,box-shadow] duration-[420ms] [transition-timing-function:var(--ease-out-expo)] site-header--overlay fixed inset-x-0 bg-transparent border-b border-transparent shadow-none" role="banner">
  <div class="container-site xl:max-w-[1400px] 2xl:max-w-[1560px] relative flex lg:grid lg:grid-cols-[auto_minmax(0,1fr)_auto] items-center gap-4 xl:gap-6 h-[88px]">
    <!-- Logo -->
    <a href="/" class="flex items-center min-w-0 lg:shrink-0 no-underline" aria-label={`${biz.name} — Home`}>
      {biz.logo ? (
        <span class="shrink-0 w-[clamp(5rem,_28vw,_7rem)] h-16 lg:w-[clamp(7rem,_12vw,_10rem)] lg:h-[4.5rem] flex items-center justify-start" aria-hidden="true">
          <img src={biz.logo} alt={`${biz.name} logo`} title={`${biz.name} logo`} width="160" height="72" class="max-w-full max-h-full w-auto h-auto object-contain" loading="eager" decoding="async" fetchpriority="high" />
        </span>
      ) : (
        <span class="wordmark" aria-hidden="true">{biz.name}</span>
      )}
    </a>
    <!-- Desktop Navigation -->
    <nav class="hidden lg:flex justify-self-center min-w-0" aria-label="Main navigation">
      <ul role="list" class="flex items-center gap-1 list-none m-0 p-0">
        <!-- Services mega-dropdown: left-aligned to the trigger, grows right -->
        <li class="relative group/services">
          <a href="/#services" class="flex items-center gap-1 px-4 py-2 text-base font-[900] text-text-secondary rounded-md transition-colors duration-150 no-underline hover:text-accent hover:bg-accent-light">
            Services
            <Icon n="931599" />
          </a>
          <!-- Invisible bridge — prevents hover gap from closing the dropdown -->
          <div class="absolute top-full left-0 right-0 h-2 pointer-events-none group-hover/services:pointer-events-auto group-focus-within/services:pointer-events-auto"></div>
          <!-- Services mega-menu panel -->
          <div class="absolute top-[calc(100%+0.5rem)] left-0 bg-surface-raised border border-border border-t-2 border-t-accent rounded-xl shadow-xl z-50 overflow-hidden opacity-0 pointer-events-none transition-[opacity,transform] duration-150 origin-top-left scale-[0.98] group-hover/services:opacity-100 group-hover/services:pointer-events-auto group-hover/services:scale-100 group-focus-within/services:opacity-100 group-focus-within/services:pointer-events-auto group-focus-within/services:scale-100" style={`width: min(${categories.length > 1 ? 520 : 300}px, calc(100vw - 2rem))`}>
            <div class="absolute -top-2 left-0 right-0 h-2"></div>
            <!-- Category columns grow in a single row toward the right -->
            <div class:list={['grid divide-x divide-border', categories.length > 1 ? 'grid-cols-2' : 'grid-cols-1']}>
              {categories.map((c) => (
                <div class="p-5 flex flex-col min-w-0">
                  <a href={categoryHref(c)} class="group/cat no-underline flex items-center min-h-[2.75rem] mb-3">
                    <span class="text-base font-[900] tracking-[0.055em] uppercase text-text leading-tight group-hover/cat:text-accent transition-colors duration-150">{c.name}</span>
                  </a>
                  <div class="h-px bg-border mb-2.5"></div>
                  <ul role="list" class="list-none m-0 p-0 flex flex-col gap-px flex-1">
                    {c.services.map((s) => (
                      <li>
                        <a href={serviceHref(c, s)} class="block px-2 py-2 text-[0.9375rem] font-medium text-text-secondary rounded-md no-underline transition-colors duration-150 hover:text-accent hover:bg-accent-light leading-snug capitalize">{s.name}</a>
                      </li>
                    ))}
                  </ul>
                  <a href={categoryHref(c)} class="mt-3 pt-3 border-t border-border flex items-center gap-1 text-[0.9375rem] font-semibold text-accent no-underline hover:underline">
                    Show all
                    <Icon n="ce4ae5" />
                  </a>
                </div>
              ))}
            </div>
            <!-- Footer: service areas breadcrumb -->
            <div class="px-5 py-3 bg-surface border-t border-border flex items-center gap-2 flex-wrap">
              <Icon n="41ce5c" />
              <span class="text-[0.8125rem] text-text-muted font-medium">Serving</span>
              {areas.map((a, i) => (
                <>
                  {i > 0 && <span class="text-text-muted select-none" aria-hidden="true">·</span>}
                  <a href={areaHref(a)} class="text-[0.8125rem] text-text-secondary no-underline hover:text-accent transition-colors duration-150 capitalize">{a.name}</a>
                </>
              ))}
              <a href="/#service-areas" class="ml-auto text-[0.8125rem] font-semibold text-accent no-underline hover:underline shrink-0">All areas →</a>
            </div>
          </div>
        </li>
        <!-- About -->
        <li>
          <a href="/about" class={`${topLink} ${activeCls('about')}`} aria-current={active === 'about' ? 'page' : undefined}>About</a>
        </li>
        <!-- Service Areas dropdown -->
        <li class="relative group/areas">
          <a href="/#service-areas" class="flex items-center gap-1 px-4 py-2 text-base font-[900] text-text-secondary rounded-md transition-colors duration-150 no-underline hover:text-accent hover:bg-accent-light">
            Service Areas
            <Icon n="804060" />
          </a>
          <div class="absolute top-[calc(100%+0.5rem)] left-1/2 -translate-x-1/2 min-w-[220px] bg-surface-raised border border-border rounded-xl shadow-xl z-50 opacity-0 pointer-events-none transition-[opacity,transform] duration-150 origin-top scale-[0.98] group-hover/areas:opacity-100 group-hover/areas:pointer-events-auto group-hover/areas:scale-100 group-focus-within/areas:opacity-100 group-focus-within/areas:pointer-events-auto group-focus-within/areas:scale-100">
            <div class="absolute -top-2 left-0 right-0 h-2"></div>
            <div class="p-2">
              {areas.map((a) => (
                <a href={areaHref(a)} class="flex items-center gap-2.5 px-4 py-2 text-[0.9375rem] font-medium text-text-secondary rounded-md no-underline transition-colors duration-150 hover:text-accent hover:bg-accent-light capitalize">
                  <Icon n="eb5cfa" /> {a.name}
                </a>
              ))}
              <div class="mt-1 pt-2 border-t border-border px-[0.875rem] pb-1">
                <a href="/#service-areas" class="text-[0.8125rem] font-semibold text-accent no-underline hover:underline">See all service areas →</a>
              </div>
            </div>
          </div>
        </li>
        <!-- Contact -->
        <li>
          <a href="/contact" class={`${topLink} ${activeCls('contact')}`} aria-current={active === 'contact' ? 'page' : undefined}>Contact</a>
        </li>
      </ul>
    </nav>
    <!-- Header CTAs -->
    <div class="hidden lg:flex items-center gap-3 justify-self-end">
      <a href={telHref} class="btn-phone text-base font-[900] py-[0.625rem] px-[1.125rem]" aria-label={`Call us at ${biz.phone}`}>
        <Icon n="5de33e" /> {biz.phone}
      </a>
      <button type="button" data-open-quote-modal class="btn-primary py-[0.625rem] px-[1.25rem] text-base font-[900]">{cta.quote}</button>
    </div>
    <!-- Mobile Call Button -->
    <a href={telHref} class="flex lg:hidden items-center gap-2 h-10 px-3 bg-accent rounded-md text-accent-fg ml-auto shrink-0 transition-colors duration-150 hover:bg-accent-hover active:bg-accent-active" aria-label={`Call us at ${biz.phone}`}>
      <Icon n="4d970c" />
      <span class="text-base font-[900]">{biz.phone}</span>
    </a>
    <!-- Mobile Toggle -->
    <button id="nav-toggle" class="flex lg:hidden flex-col justify-center gap-[5px] w-10 h-10 p-2 bg-transparent border border-border rounded-md cursor-pointer ml-2" aria-label="Open navigation menu" aria-expanded="false" aria-controls="mobile-nav">
      <span class="block w-full h-[1.5px] bg-text rounded-full transition-[transform,opacity] duration-200"></span>
      <span class="block w-full h-[1.5px] bg-text rounded-full transition-[transform,opacity] duration-200"></span>
      <span class="block w-full h-[1.5px] bg-text rounded-full transition-[transform,opacity] duration-200"></span>
    </button>
  </div>
</header>
