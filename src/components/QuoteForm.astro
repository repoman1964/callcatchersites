---
import { business } from "../data/site";
---
<form class="form-card" id="quoteForm" action="/book" method="get" aria-label="Instant quote form">
  <h3 style="margin-bottom:4px">See your price</h3>
  <p style="font-size:14px;color:var(--text2)">Flat price by home size. No sales call.</p>
  <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px">
    <div class="field">
      <label for="q-beds">Bedrooms</label>
      <select id="q-beds" name="beds"><option>1</option><option>2</option><option selected>3</option><option>4</option><option>5+</option></select>
    </div>
    <div class="field">
      <label for="q-baths">Bathrooms</label>
      <select id="q-baths" name="baths"><option>1</option><option selected>2</option><option>3</option><option>4+</option></select>
    </div>
  </div>
  <div class="field">
    <label id="q-freq-label">Frequency</label>
    <div class="segmented" role="radiogroup" aria-labelledby="q-freq-label">
      <label><input type="radio" name="freq" value="weekly" /> Weekly</label>
      <label><input type="radio" name="freq" value="biweekly" checked /> Every 2 weeks</label>
      <label><input type="radio" name="freq" value="monthly" /> Monthly</label>
      <label><input type="radio" name="freq" value="onetime" /> One-time</label>
    </div>
  </div>
  <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px">
    <div class="field"><label for="q-name">Full name *</label><input id="q-name" name="name" required autocomplete="name" /></div>
    <div class="field"><label for="q-phone">Phone *</label><input id="q-phone" name="phone" type="tel" required autocomplete="tel" /></div>
  </div>
  <div class="field"><label for="q-email">Email *</label><input id="q-email" name="email" type="email" required autocomplete="email" /></div>
  <div class="field"><label for="q-addr">Property address *</label><input id="q-addr" name="address" required autocomplete="street-address" /></div>
  <div class="live-price" aria-live="polite">
    <span>Estimated: <strong class="price-figure" id="q-price" style="font-size:28px">$170</strong> <span style="font-size:13px;color:var(--text2)">per clean</span></span>
  </div>
  <p style="font-size:12px;color:var(--text2);margin:-8px 0 12px">Final price confirmed before your first visit.</p>
  <button class="btn btn-primary" type="submit" style="width:100%">See My Price &amp; Book →</button>
  <p style="font-size:14px;margin:12px 0 0">Prefer to talk? Call or text <a href={business.phoneTel}>{business.phoneDisplay}</a> · <a href={business.phoneSms}>Text us</a></p>
  <p class="consent">By submitting, you agree to receive calls and texts about your quote from {business.name}. Msg &amp; data rates may apply. Reply STOP to opt out.</p>
</form>
<script>
  function est(bBaths: string, bths: string, f: string): number {
    const bedMap: Record<string, number> = { "1": 110, "2": 135, "3": 170, "4": 220, "5+": 270 };
    const bathMap: Record<string, number> = { "1": 0, "2": 20, "3": 40, "4+": 60 };
    const mult: Record<string, number> = { weekly: 0.9, biweekly: 1.0, monthly: 1.15, onetime: 1.3 };
    const raw = ((bedMap[bBaths] ?? 170) + (bathMap[bths] ?? 20)) * (mult[f] ?? 1);
    return Math.round(raw / 5) * 5;
  }
  function upd() {
    const beds = (document.getElementById("q-beds") as HTMLSelectElement)?.value ?? "3";
    const baths = (document.getElementById("q-baths") as HTMLSelectElement)?.value ?? "2";
    const freq = (document.querySelector('input[name="freq"]:checked') as HTMLInputElement)?.value ?? "biweekly";
    const el = document.getElementById("q-price");
    if (el) el.textContent = "$" + est(beds, baths, freq);
  }
  document.getElementById("q-beds")?.addEventListener("change", upd);
  document.getElementById("q-baths")?.addEventListener("change", upd);
  document.querySelectorAll('input[name="freq"]').forEach((r) => r.addEventListener("change", upd));
  upd();
</script>
