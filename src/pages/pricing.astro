---
import BaseLayout from "../layouts/BaseLayout.astro";
import TrustBar from "../components/TrustBar.astro";
import PricingCalc from "../components/PricingCalc.astro";
import { business } from "../data/site";
---
<BaseLayout
  title="Flat House Cleaning Prices in Atlanta | See Yours Right Now!"
  description="Flat Atlanta cleaning prices by home size. Instant calculator, full price table, add-ons, no hidden fees. Recurring clients save 10-20% today."
>
  <div class="hero">
    <div class="container" style="max-width:860px">
      <span class="eyebrow">Pricing</span>
      <h1>Flat cleaning prices. See yours now.</h1>
      <p class="lead">Priced by size, not hours. Recurring clients save 10–20% versus one-time cleans. No contracts, no hidden fees.</p>
      <div style="margin-top:24px"><PricingCalc /></div>
    </div>
  </div>

  <TrustBar />
  <section aria-label="Price table">
    <div class="container">
      <h2>Full price table.</h2>
      <div style="overflow-x:auto">
      <table class="price-table">
        <thead><tr><th>Service</th><th>1–2 bed</th><th>3 bed</th><th>4+ bed</th></tr></thead>
        <tbody>
          <tr><td>Recurring (per visit)</td><td>$110–$160</td><td>$150–$210</td><td>$200–$300</td></tr>
          <tr><td>Deep clean</td><td>$220–$350</td><td>$280–$420</td><td>$400–$650</td></tr>
          <tr><td>Move-in / move-out</td><td>$250–$400</td><td>$350–$550</td><td>$500–$800</td></tr>
          <tr><td>Airbnb turnover</td><td colspan="3">$75–$180 per turnover by unit size · linen service add-on</td></tr>
          <tr><td>Post-construction</td><td colspan="3">Typically $0.30–$0.60/sq ft · quoted after walkthrough or photos · <a href="/contact">request a quote →</a></td></tr>
          <tr><td>Office</td><td colspan="3">Quoted per space · most small offices $120–$300/visit · <a href="/contact">request a quote →</a></td></tr>
        </tbody>
      </table>
      </div>
      <h3 style="margin-top:32px">Add-ons</h3>
      <ul>
        <li>Inside oven — $35</li>
        <li>Inside fridge — $35</li>
        <li>Interior windows — $75</li>
        <li>Laundry fold — $25</li>
        <li>Inside cabinets — $50</li>
      </ul>
      <h3>How pricing works</h3>
      <ul>
        <li>Priced by home size and service — not by the hour. A slower clean never costs you more.</li>
        <li>Recurring discounts: weekly and every-2-weeks rates lowest; monthly higher; one-time highest.</li>
        <li>If your home differs from what you booked, we confirm the adjusted price before starting — never on the invoice.</li>
        <li>No hidden fees. Card charged after each clean.</li>
      </ul>
      <p><a class="btn btn-primary" href="/book">Book at your price →</a></p>
    </div>
  </section>
</BaseLayout>
